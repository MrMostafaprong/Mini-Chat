# ==============================================
# MiniChat Server Environment Variables
# ==============================================

# ---------- Server ----------
# Port and Host
PORT=5000
HOST=0.0.0.0

# Node environment: development, production, test
NODE_ENV=development

# ---------- Database ----------
# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minichat
DB_USER=minichat_user
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Enable SSL for database connection (true/false)
DB_SSL=false

# ---------- Security ----------
# JWT Secret - MUST be a long random string (use `openssl rand -hex 64` to generate)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARACTERS

# JWT expiration time (e.g., 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# CORS allowed origins (comma separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting: max requests per windowMs
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------- Socket.IO ----------
# Socket.IO CORS (should match CORS_ORIGINS)
SOCKET_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- File Uploads (if implemented) ----------
# Max file size in bytes (e.g., 5MB = 5242880)
MAX_FILE_SIZE=5242880